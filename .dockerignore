# Git
.git
.gitignore

# Node dependencies
**/node_modules

# Frontend build outputs
client/dist
**/dist

# SQLite runtime databases
**/*.db
**/*.db-journal
**/*.db-shm
**/*.db-wal
server/data/*.db
server/data/*.db-shm
server/data/*.db-wal
!server/data/seed.json

# Local environment variables
.env
.env.local
.env.*.local
!.env.example

# Logs
**/*.log
logs/

# OS and Editor files
.DS_Store
Thumbs.db
.idea
.vscode
*.swp
*.swo
