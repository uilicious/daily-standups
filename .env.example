PORT=3000
NODE_ENV=development
SESSION_SECRET=standups-secret-key-at-least-32-characters-long!
APP_URL=http://localhost:3000

# ==============================================================================
# ADMIN CREDENTIALS
# ==============================================================================
# If ADMIN_PASSWORD is provided, the server will ALWAYS reset the admin user's
# password to this value on server startup.
ADMIN_PASSWORD=adminpassword123
ADMIN_EMAIL=admin@example.com

# ==============================================================================
# DATABASE CONFIGURATION (Knex: SQLite, MySQL, or PostgreSQL)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SQLite (Default - Zero configuration required)
# ------------------------------------------------------------------------------
DB_CLIENT=better-sqlite3
SQLITE_FILENAME=./data/standups.db

# ------------------------------------------------------------------------------
# 2. MySQL / MariaDB (Commented out example)
# ------------------------------------------------------------------------------
# DB_CLIENT=mysql2
# DATABASE_URL=mysql://standup_user:standup_password@127.0.0.1:3306/daily_standups
#
# Alternatively using discrete environment variables:
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=standup_user
# MYSQL_PASSWORD=standup_password
# MYSQL_DATABASE=daily_standups

# ------------------------------------------------------------------------------
# 3. PostgreSQL (Commented out example)
# ------------------------------------------------------------------------------
# DB_CLIENT=pg
# DATABASE_URL=postgres://standup_user:standup_password@127.0.0.1:5432/daily_standups
#
# Alternatively using discrete environment variables:
# PGHOST=127.0.0.1
# PGPORT=5432
# PGUSER=standup_user
# PGPASSWORD=standup_password
# PGDATABASE=daily_standups
# PGSSL=false

# ==============================================================================
# OPTIONAL GOOGLE OAUTH SSO
# ==============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
